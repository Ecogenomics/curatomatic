{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md", "changelogTitle": "# Changelog" }],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "echo '${nextRelease.version}' > .release-version",
        "prepareCmd": "sed -i -E '/^\\[package\\]/,/^\\[/ s/^version = \".*\"/version = \"${nextRelease.version}\"/' Cargo.toml && grep -q '^version = \"${nextRelease.version}\"$' Cargo.toml && cargo update --workspace --offline"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["Cargo.toml", "Cargo.lock", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
